# Copy to .env and fill in real values. Never commit .env.

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback

# GitHub API (optional - for enhanced GitHub features)
GITHUB_TOKEN=

# Server Config
OCTO_PORT=8080
OCTO_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Session Secret (generate a random string - min 32 chars)
SESSION_SECRET=change-me-to-a-random-string-of-32-or-more-chars
